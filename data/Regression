  {
   "cell_type": "markdown",
   "id": "81be14aa",
   "metadata": {},
   "source": [
    "Handling Multi-select columns. \n",
    "Once hot encoding for all of those columns would create too many columns. My strategy is to split columns into most relevant to salary (like prog.language, databases etc.) and less relevant to salary (like personal.os, project.mgmt.tools etc.) only create one hot encoding for the top 10 values of the "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "89350fe4",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Multi-select columns: salary-relevant → top-10 multi-hot + count\n",
    "# Others → count only\n",
    "\n",
    "multi_hot_cols = ['prog.languages', 'databases', 'cloud.platforms', \n",
    "                  'web.frameworks', 'other.tech', 'dev.tools', 'dev.environments']\n",
    "\n",
    "count_only_cols = ['personal.os', 'work.os', 'project.mgmt.tools', 'comm.tools',\n",
    "                   'ai.search.tools', 'ai.tools.used', 'side.coding', 'how.learned.coding']\n",
    "\n",
    "# --- Multi-hot + count for salary-relevant columns ---\n",
    "top_values_dict = {}  # store top values per column (learned from train only)\n",
    "\n",
    "for col in multi_hot_cols:\n",
    "    # Count column\n",
    "    X_train[f\"{col}__count\"] = X_train[col].fillna('').str.split(';').apply(lambda x: len([i for i in x if i.strip()]))\n",
    "    X_val[f\"{col}__count\"] = X_val[col].fillna('').str.split(';').apply(lambda x: len([i for i in x if i.strip()]))\n",
    "    \n",
    "    # Top 10 values from train\n",
    "    top_vals = (X_train[col].dropna().str.split(';').explode().str.strip()\n",
    "                .value_counts().head(10).index.tolist())\n",
    "    top_values_dict[col] = top_vals\n",
    "    \n",
    "    for val in top_vals:\n",
    "        X_train[f\"{col}__{val}\"] = X_train[col].fillna('').str.contains(val, regex=False).astype(int)\n",
    "        X_val[f\"{col}__{val}\"] = X_val[col].fillna('').str.contains(val, regex=False).astype(int)\n",
    "    \n",
    "    # Drop original\n",
    "    X_train = X_train.drop(columns=[col])\n",
    "    X_val = X_val.drop(columns=[col])\n",
    "\n",
    "# --- Count only for less relevant columns ---\n",
    "for col in count_only_cols:\n",
    "    X_train[f\"{col}__count\"] = X_train[col].fillna('').str.split(';').apply(lambda x: len([i for i in x if i.strip()]))\n",
    "    X_val[f\"{col}__count\"] = X_val[col].fillna('').str.split(';').apply(lambda x: len([i for i in x if i.strip()]))\n",
    "    \n",
    "    X_train = X_train.drop(columns=[col])\n",
    "    X_val = X_val.drop(columns=[col])\n",
    "\n",
    "print(f\"New shape - Train: {X_train.shape}, Val: {X_val.shape}\")"
   ]
  },
